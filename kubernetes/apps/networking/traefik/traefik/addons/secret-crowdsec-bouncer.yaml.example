# Template only - NOT referenced by kustomization.yaml.
# Copy of the CrowdSec bouncer key for Traefik (namespace networking): mounted
# into the Traefik pods as /etc/traefik/crowdsec/lapi-key (base/release.yaml,
# optional volume) and read via crowdsecLapiKeyFile (middleware-crowdsec.yaml).
#   cp secret-crowdsec-bouncer.yaml.example secret-crowdsec-bouncer.yaml
#   sops --encrypt --age <same recipient as the other secret.yaml files> \
#        --encrypted-regex '^(data|stringData)$' --in-place secret-crowdsec-bouncer.yaml
# then add it to kustomization.yaml. The value MUST equal BOUNCER_KEY_traefik in
#   kubernetes/apps/security/crowdsec/crowdsec/app/secret.yaml
# After the first apply, restart Traefik once so the public middleware is rebuilt
# with the key: kubectl -n networking rollout restart ds/traefik
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-bouncer-key
stringData:
  BOUNCER_KEY_traefik: "<same-value-as-crowdsec-namespace-secret>"
