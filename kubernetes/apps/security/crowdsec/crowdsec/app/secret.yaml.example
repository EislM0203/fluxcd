# Template only - NOT referenced by kustomization.yaml.
#   cp secret.yaml.example secret.yaml   # fill in the value
#   sops --encrypt --age <same recipient as the other secret.yaml files> \
#        --encrypted-regex '^(data|stringData)$' --in-place secret.yaml
# Then list secret.yaml in kustomization.yaml and set suspend: false in ../ks.yaml.
#
# BOUNCER_KEY_traefik: the LAPI API key of the Traefik bouncer. The LAPI start
#   script registers bouncer "traefik" with exactly this key (env BOUNCER_KEY_<name>).
#   Generate once, e.g.:   openssl rand -hex 32
#   (plugin only accepts [a-zA-Z0-9 !#$%&'*+-.^_`|~=/] - hex is safe)
# The SAME value must go into
#   kubernetes/apps/networking/traefik/traefik/addons/secret-crowdsec-bouncer.yaml
# (Traefik reads it from a file mounted out of that copy).
apiVersion: v1
kind: Secret
metadata:
  name: crowdsec-bouncer-key
stringData:
  BOUNCER_KEY_traefik: "<openssl-rand-hex-32>"
