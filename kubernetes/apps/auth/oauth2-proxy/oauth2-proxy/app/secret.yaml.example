# Template only — NOT referenced by kustomization.yaml.
#   cp secret.yaml.example secret.yaml   # fill in values
#   sops --encrypt --age <same recipient as the other secret.yaml files> \
#        --encrypted-regex '^(data|stringData)$' --in-place secret.yaml
# CLIENT_ID / CLIENT_SECRET: from the Pocket ID OIDC client (callback URL
#   https://oauth.cloud.traunseenet.com/oauth2/callback).
# COOKIE_SECRET: 32 random bytes, e.g.
#   openssl rand -base64 32 | tr -- '+/' '-_'
apiVersion: v1
kind: Secret
metadata:
  name: oauth2-proxy-secret
stringData:
  OAUTH2_PROXY_CLIENT_ID: "<pocket-id-client-id>"
  OAUTH2_PROXY_CLIENT_SECRET: "<pocket-id-client-secret>"
  OAUTH2_PROXY_COOKIE_SECRET: "<32-byte-random-base64url>"
