# Template only — NOT referenced by kustomization.yaml.
#
# Cloudflare API token (dash.cloudflare.com → My Profile → API Tokens → Create Token
# → "Create Custom Token"):
#   Permissions:      Zone → DNS → Edit
#                     Zone → Zone → Read
#   Zone Resources:   Include → Specific zone → traunseenet.com   (ONLY this zone)
#   (optional) Client IP Address Filtering: your WAN IP; TTL: as you like.
# Use a NEW token dedicated to this instance — not cert-manager's or tofu's.
#
#   cp secret.yaml.example secret.yaml        # paste the token
#   sops --encrypt --age age1q3mu6g0l3kr7spszks69yqrvlxvlgfrqgw9r00qqt8cj9xpjd9mqdkd7um \
#        --encrypted-regex '^(data|stringData)$' --in-place secret.yaml
#   then uncomment secret.yaml in kustomization.yaml and set suspend: false in ../ks.yaml
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
stringData:
  CF_API_TOKEN: "<cloudflare-api-token>"
