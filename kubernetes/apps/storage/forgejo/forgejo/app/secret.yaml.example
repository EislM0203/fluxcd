# Copy to secret.yaml, fill in, then encrypt:
#   sops --encrypt --encrypted-regex '^(data|stringData)$' --age <recipient> --in-place secret.yaml
# Generate values:  SECRET_KEY:     forgejo generate secret SECRET_KEY   (or: openssl rand -hex 32)
#                   INTERNAL_TOKEN: forgejo generate secret INTERNAL_TOKEN (or: openssl rand -hex 48)
---
apiVersion: v1
kind: Secret
metadata:
  name: forgejo-secrets
stringData:
  SECRET_KEY: <random>
  INTERNAL_TOKEN: <random>
  OIDC_CLIENT_ID: <pocket-id client id>
  OIDC_CLIENT_SECRET: <pocket-id client secret>
---
# VolSync restic repo for the forgejo-data PVC (same keys as restic-gitea)
apiVersion: v1
kind: Secret
metadata:
  name: restic-forgejo
stringData:
  RESTIC_REPOSITORY: <s3:http://.../forgejo>
  RESTIC_PASSWORD: <random>
  AWS_ACCESS_KEY_ID: <...>
  AWS_SECRET_ACCESS_KEY: <...>
---
# CNPG barman backups (s3://cnpg-backups/forgejo)
apiVersion: v1
kind: Secret
metadata:
  name: s3-forgejo-pg-backup
stringData:
  AWS_ACCESS_KEY_ID: <...>
  AWS_SECRET_ACCESS_KEY: <...>
