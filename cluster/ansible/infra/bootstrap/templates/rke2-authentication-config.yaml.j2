# Kubernetes SSO through Pocket ID: kubectl users log in with kubelogin and get
# RBAC from their Pocket ID groups (ClusterRoleBinding in
# kubernetes/apps/kube-system/oidc-rbac). The RKE2 client certificates
# (/etc/rancher/rke2/rke2.yaml, ~/.kube/rke2-admin.yaml) keep working as
# break-glass while Pocket ID or Traefik is down.
apiVersion: apiserver.config.k8s.io/v1
kind: AuthenticationConfiguration
jwt:
  - issuer:
      url: {{ rke2_oidc_issuer_url }}
      audiences:
        - {{ rke2_oidc_client_id }}
    claimMappings:
      # Not email: with the email claim the API server rejects every token whose
      # email_verified is not true. The prefix keeps OIDC names out of system:*.
      username:
        claim: preferred_username
        prefix: "oidc:"
      groups:
        claim: groups
        prefix: "oidc:"
