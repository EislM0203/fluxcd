# Kubernetes API audit policy. First matching rule wins.
# Never raise Secret/ConfigMap/TokenReview above Metadata: Request/RequestResponse
# would write their contents into the log (and Loki).
apiVersion: audit.k8s.io/v1
kind: Policy
omitStages:
  - RequestReceived
rules:
  # Pure noise: health/metrics probes, events, leader-election leases
  - level: None
    nonResourceURLs:
      - /healthz*
      - /livez*
      - /readyz*
      - /version
      - /metrics
      - /openapi*
  - level: None
    resources:
      - group: ""
        resources: [events]
      - group: events.k8s.io
        resources: [events]
      - group: coordination.k8s.io
        resources: [leases]
      # metrics-server/webhooks asking "may X do Y" on every scrape
      - group: authorization.k8s.io
      # RKE2's own addon reconcile loop
      - group: k3s.cattle.io
  # Watches are long-lived controller streams that re-open every few minutes;
  # get/list on secrets is still logged below
  - level: None
    verbs: [watch]
  # Kubelets reading what their pods mount (the node authorizer already scopes this)
  - level: None
    userGroups: ["system:nodes"]
    verbs: [get, list, watch]
  # Controllers reporting status: by far the bulk of writes, no security value
  - level: None
    verbs: [update, patch]
    resources:
      - group: ""
        resources: ["*/status"]
      - group: apps
        resources: ["*/status"]
      - group: batch
        resources: ["*/status"]
      - group: external-secrets.io
        resources: ["*/status"]
      - group: volsync.backube
        resources: ["*/status"]
      - group: postgresql.cnpg.io
        resources: ["*/status"]
      - group: helm.toolkit.fluxcd.io
        resources: ["*/status"]
      - group: kustomize.toolkit.fluxcd.io
        resources: ["*/status"]
      - group: source.toolkit.fluxcd.io
        resources: ["*/status"]
      - group: cert-manager.io
        resources: ["*/status"]
  # Longhorn managing its own CRs (engines, replicas, nodes, ...)
  - level: None
    users: ["system:serviceaccount:longhorn-system:longhorn-service-account"]
    resources:
      - group: longhorn.io

  # Who touched secrets (any verb, including reads): user, object, verb, result
  - level: Metadata
    resources:
      - group: ""
        resources: [secrets, configmaps, serviceaccounts/token]
      - group: authentication.k8s.io
        resources: [tokenreviews]

  # Interactive access into pods
  - level: Metadata
    resources:
      - group: ""
        resources: [pods/exec, pods/attach, pods/portforward, pods/proxy, nodes/proxy, services/proxy]

  # RBAC and admission changes: keep the request body (what was granted)
  - level: Request
    verbs: [create, update, patch, delete, deletecollection]
    resources:
      - group: rbac.authorization.k8s.io
      - group: admissionregistration.k8s.io

  # Other reads are controllers watching the world; drop them
  - level: None
    verbs: [get, list, watch]

  # Every remaining write: who changed what
  - level: Metadata
